declare const BRAND: unique symbol;

/**
 * Compile-time brand helper — keeps the {{dashCase name}} context's IDs distinct
 * from each other and from other strings even though all are plain strings at
 * runtime. A branded type is structurally identical to `T` at runtime but is
 * treated as a distinct type by the TypeScript compiler.
 */
// eslint-disable-next-line @typescript-eslint/no-unused-vars -- used by each Agg.Id below, appended by new:aggregate; unused only in a bare context skeleton
type Brand<T, B> = T & { readonly [BRAND]: B };

