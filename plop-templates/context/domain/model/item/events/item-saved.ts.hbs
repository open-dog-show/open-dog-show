import {
    asEventType,
    type AggregateId,
    type DomainEventFact,
    type EventScope,
    type EventType,
} from '../../../../../Shared/index.js';

/**
 * The fully-qualified event-type string for {@link ItemSaved} — the wire/DB
 * form stored in the outbox `type` column and the registry key the codec uses
 * to rehydrate a stored row back into an {@link ItemSaved} instance.
 */
export const ITEM_SAVED_TYPE: EventType = asEventType('{{eventContext name}}.ItemSaved');

/** Event-type-specific structured data carried by {@link ItemSaved}. */
export interface ItemSavedPayload {
    readonly name: string;
}

/**
 * The fact that an {@link Item} was saved.
 *
 * Modelled as a **class event** implementing {@link DomainEventFact} (ADR-0027):
 * the `type` field is fixed to {@link ITEM_SAVED_TYPE}; the payload is the
 * typed {@link ItemSavedPayload}. Carries no `eventId` / `occurredAt` — those
 * are envelope fields the unit of work stamps on afterwards, never this class
 * or its caller. A private `#brand` field makes the class **nominal** so a
 * bare fact literal is not assignable to `ItemSaved`.
 *
 * Storage rehydration goes through {@link ItemSaved.rehydrate}, which this
 * context's rehydration registry wires into the outbox codec / polling
 * dispatcher.
 */
export class ItemSaved implements DomainEventFact {
    // Nominal brand: a bare object literal lacks this private field, so it is
    // not assignable to `ItemSaved` — closes the structural-literal leak.
    // eslint-disable-next-line no-unused-private-class-members -- intentional nominal brand; exists for compile-time type pinning, not runtime use.
    readonly #brand = true;

    readonly type = ITEM_SAVED_TYPE;
    readonly scope: EventScope;
    readonly aggregateId: AggregateId;
    readonly payload: ItemSavedPayload;

    private constructor(scope: EventScope, aggregateId: AggregateId, payload: ItemSavedPayload) {
        this.scope = scope;
        this.aggregateId = aggregateId;
        this.payload = payload;
    }

    /** Constructs an {@link ItemSaved} fact for recording. */
    static create(
        aggregateId: AggregateId,
        scope: EventScope,
        payload: ItemSavedPayload,
    ): ItemSaved {
        return new ItemSaved(scope, aggregateId, payload);
    }

    /**
     * Rehydrates an {@link ItemSaved} fact from a stored row's
     * already-validated fields — the path the outbox codec / polling
     * dispatcher use via this context's rehydration registry.
     */
    static rehydrate(fact: {
        readonly scope: EventScope;
        readonly aggregateId: AggregateId;
        readonly payload: ItemSavedPayload;
    }): ItemSaved {
        return new ItemSaved(fact.scope, fact.aggregateId, fact.payload);
    }
}
