import {
    asAggregateId,
    ClubEventScope,
    requireClubScope,
    type TransactionScope,
} from '../../../Shared/index.js';
import type { Item } from '../../domain/model/item/item.js';
import { ItemSaved } from '../../domain/model/item/events/item-saved.js';
import type { ItemUnitOfWork } from '../ports/unit-of-work.js';

/**
 * Inputs to {@link SaveItemUseCase.execute} that are not derivable from the
 * transaction scope. The owning Club comes from the `TransactionScope` (via
 * {@link requireClubScope}); everything the caller controls lives here.
 */
export interface SaveItemInput {
    /** Aggregate id of the Item to save (upserts on conflict). */
    readonly id: string;
    /** The Item's name. */
    readonly name: string;
}

/**
 * Construct the {@link Item} from the use-case input and the owning Club.
 *
 * An Item is Club-owned outright (not hybrid), so `scope` must itself be a
 * `club` scope (ADR-0026) — {@link requireClubScope} throws
 * `ScopeMismatchError` for any other scope kind.
 */
function toItem(input: SaveItemInput, scope: TransactionScope): Item {
    return { id: input.id, clubId: requireClubScope(scope), name: input.name };
}

/**
 * Use case: save (upsert) an Item and record the `{{eventContext name}}.ItemSaved`
 * fact in the same transaction (ADR-0014).
 *
 * The transaction boundary, repository construction, and outbox write are all
 * hidden behind the injected {@link ItemUnitOfWork} port, so this class
 * depends only on domain types and `@ods/kernel` — it is trivially unit-testable
 * with a fake unit of work and no Docker.
 */
export class SaveItemUseCase {
    /** @param unitOfWork - The per-context unit-of-work port (transaction + repo + outbox). */
    constructor(private readonly unitOfWork: ItemUnitOfWork) {}

    /**
     * Save the Item described by `input` under `scope` and emit the
     * `{{eventContext name}}.ItemSaved` domain event in the same transaction.
     *
     * @throws {ScopeMismatchError} when `scope` is not a `club` scope.
     */
    async execute(input: SaveItemInput, scope: TransactionScope): Promise<void> {
        const item = toItem(input, scope);
        await this.unitOfWork.run(scope, async (ctx) => {
            await ctx.items.save(item);
            ctx.record(
                ItemSaved.create(asAggregateId(item.id), ClubEventScope.of(item.clubId), {
                    name: item.name,
                }),
            );
        });
    }
}
