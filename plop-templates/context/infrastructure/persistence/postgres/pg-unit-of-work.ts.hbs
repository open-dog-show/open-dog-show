import type pg from 'pg';
import {
    withOutboxTransaction,
    type Clock,
    type EventIdGenerator,
    type PgOutboxWriter,
    type TransactionScope,
} from '../../../../Shared/index.js';
import { DrizzleItemRepository } from './drizzle-item-repository.js';
import type { ItemUnitOfWork, ItemUnitOfWorkContext } from '../../../application/ports/unit-of-work.js';

/**
 * PostgreSQL implementation of the {{name}}-context {@link ItemUnitOfWork} port
 * (ADR-0014).
 *
 * Wraps the kernel's `withOutboxTransaction`: it opens the transaction, sets the
 * RLS session variables from `scope`, constructs the Drizzle repository inside
 * the transaction, runs `body` against an {@link ItemUnitOfWorkContext}, then
 * atomically writes any recorded domain facts to the outbox before commit (or
 * rolls back on error). The application layer never sees `pg`,
 * `pg.PoolClient`, or `withOutboxTransaction`.
 *
 * Constructed once at the composition root with a `pg.Pool`, a
 * `PgOutboxWriter`, and the `Clock` / `EventIdGenerator` ports used to stamp
 * event envelopes; injected into use-case classes.
 */
export class PgItemUnitOfWork implements ItemUnitOfWork {
    /**
     * @param pool - The PostgreSQL connection pool (app role, RLS-enforced).
     * @param writer - The schema-scoped outbox writer for this context.
     * @param clock - Stamps `occurredAt` on recorded facts.
     * @param eventIdGenerator - Stamps `eventId` on recorded facts.
     */
    constructor(
        private readonly pool: pg.Pool,
        private readonly writer: PgOutboxWriter,
        private readonly clock: Clock,
        private readonly eventIdGenerator: EventIdGenerator,
    ) {}

    async run<T>(scope: TransactionScope, body: (ctx: ItemUnitOfWorkContext) => Promise<T>): Promise<T> {
        return withOutboxTransaction(
            this.pool,
            scope,
            this.writer,
            this.clock,
            this.eventIdGenerator,
            async (client, record) => {
                const ctx: ItemUnitOfWorkContext = {
                    items: new DrizzleItemRepository(client),
                    record,
                };
                return body(ctx);
            },
        );
    }
}
