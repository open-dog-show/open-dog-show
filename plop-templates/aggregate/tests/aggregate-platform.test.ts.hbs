import { describe, it, expect } from 'vitest';
import { PlatformEventScope } from '../../../../../src/Shared/index.js';
import {
    {{pascalCase name}},
    Invalid{{pascalCase name}}NameError,
} from '../../../../../src/{{dashCase context}}/domain/model/{{dashCase name}}/{{dashCase name}}.js';
import { as{{pascalCase name}}Id } from '../../../../../src/{{dashCase context}}/domain/shared/domain-ids.js';

const {{constantCase name}}_ID = as{{pascalCase name}}Id('00000000-0000-4000-8000-000000000021');

describe('{{pascalCase name}}', () => {
    it('create records {{pascalCase name}}Created scoped platform-wide', () => {
        const {{camelCase name}} = {{pascalCase name}}.create({ id: {{constantCase name}}_ID, name: 'Original name' });

        const [event] = {{camelCase name}}.pullEvents();
        expect(event?.type).toBe('{{eventContext context}}.{{pascalCase name}}Created');
        expect(event?.scope).toEqual(PlatformEventScope.of());
        expect(event?.payload).toEqual({ name: 'Original name' });
        expect({{camelCase name}}.name).toBe('Original name');
        expect({{camelCase name}}.version).toBe(1);
    });

    it('create rejects a blank name', () => {
        expect(() => {{pascalCase name}}.create({ id: {{constantCase name}}_ID, name: '   ' })).toThrow(
            Invalid{{pascalCase name}}NameError,
        );
    });

    it('rehydrate does not record an event', () => {
        const {{camelCase name}} = {{pascalCase name}}.rehydrate({
            id: {{constantCase name}}_ID,
            name: 'Restored name',
            version: 3,
        });

        expect({{camelCase name}}.pullEvents()).toEqual([]);
        expect({{camelCase name}}.name).toBe('Restored name');
        expect({{camelCase name}}.version).toBe(3);
    });

    it('rename records {{pascalCase name}}Renamed and updates the name, leaving version unchanged', () => {
        const {{camelCase name}} = {{pascalCase name}}.rehydrate({
            id: {{constantCase name}}_ID,
            name: 'Old name',
            version: 3,
        });

        {{camelCase name}}.rename('New name');

        const [event] = {{camelCase name}}.pullEvents();
        expect(event?.type).toBe('{{eventContext context}}.{{pascalCase name}}Renamed');
        expect(event?.scope).toEqual(PlatformEventScope.of());
        expect(event?.payload).toEqual({ name: 'New name' });
        expect({{camelCase name}}.name).toBe('New name');
        expect({{camelCase name}}.version).toBe(3);
    });

    it('rename rejects a blank name', () => {
        const {{camelCase name}} = {{pascalCase name}}.rehydrate({
            id: {{constantCase name}}_ID,
            name: 'Old name',
            version: 1,
        });

        expect(() => { {{camelCase name}}.rename(''); }).toThrow(Invalid{{pascalCase name}}NameError);
    });
});
