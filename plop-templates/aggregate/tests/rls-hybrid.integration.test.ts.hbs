import { describe, it, expect, beforeAll, afterAll } from 'vitest';
import { PostgresHarness } from '../../../../test-kit/index.js';
import { bootstrap{{pascalCase context}}Schema } from '../../../fixtures.js';
import {
    asClubId,
    asPrincipalId,
    ClubTransactionScope,
    ExhibitorTransactionScope,
    PgOutboxWriter,
} from '../../../../../src/Shared/index.js';
import { SystemClock } from '../../../../../src/Shared/infrastructure/system-clock.js';
import { RandomEventIdGenerator } from '../../../../../src/Shared/infrastructure/random-event-id-generator.js';
import { Pg{{pascalCase context}}UnitOfWork } from '../../../../../src/{{dashCase context}}/infrastructure/persistence/postgres/pg-unit-of-work.js';
import { {{pascalCase parent}} } from '../../../../../src/{{dashCase context}}/domain/model/{{dashCase parent}}/{{dashCase parent}}.js';
import { {{pascalCase name}} } from '../../../../../src/{{dashCase context}}/domain/model/{{dashCase name}}/{{dashCase name}}.js';
import {
    as{{pascalCase name}}Id,
    as{{pascalCase parent}}Id,
} from '../../../../../src/{{dashCase context}}/domain/shared/domain-ids.js';

const CLUB_A_ID = asClubId('00000000-0000-4000-8000-000000000001');
const CLUB_B_ID = asClubId('00000000-0000-4000-8000-000000000002');
const CLUB_A_PRINCIPAL_ID = asPrincipalId('00000000-0000-4000-8000-000000000011');
const CLUB_B_PRINCIPAL_ID = asPrincipalId('00000000-0000-4000-8000-000000000012');
const EXHIBITOR_A_ID = asPrincipalId('00000000-0000-4000-8000-000000000021');
const EXHIBITOR_B_ID = asPrincipalId('00000000-0000-4000-8000-000000000022');
const {{constantCase parent}}_ID = as{{pascalCase parent}}Id('00000000-0000-4000-8000-000000000031');
const {{constantCase name}}_ID = as{{pascalCase name}}Id('00000000-0000-4000-8000-000000000041');

/**
 * Proves the ADR-0005 hybrid RLS policy: {{a (pascalCase name)}} {{pascalCase name}} created by an
 * exhibitor acting cross-Club is visible to that exhibitor (matched by
 * `user_id`) and to the owning Club (matched by `club_id`) — and to no one
 * else.
 */
describe('{{pascalCase name}} RLS isolation (hybrid scope)', () => {
    const harness = new PostgresHarness();
    let unitOfWork: Pg{{pascalCase context}}UnitOfWork;

    beforeAll(async () => {
        await bootstrap{{pascalCase context}}Schema(harness);
        unitOfWork = new Pg{{pascalCase context}}UnitOfWork(
            harness.appUserPool,
            new PgOutboxWriter('{{snakeCase context}}'),
            new SystemClock(),
            new RandomEventIdGenerator(),
        );

        await unitOfWork.run(ClubTransactionScope.of(CLUB_A_ID, CLUB_A_PRINCIPAL_ID), async (ctx) => {
            await ctx.{{plural (camelCase parent)}}.add(
                {{pascalCase parent}}.create({
                    id: {{constantCase parent}}_ID,
                    clubId: CLUB_A_ID,
                    createdBy: CLUB_A_PRINCIPAL_ID,
                    name: 'Club {{A (pascalCase parent)}} {{pascalCase parent}}',
                }),
            );
        });

        // Exhibitor A creates the {{pascalCase name}} cross-Club, referencing
        // Club A's {{pascalCase parent}} — the acting scope carries no clubId at all.
        await unitOfWork.run(ExhibitorTransactionScope.of(EXHIBITOR_A_ID), async (ctx) => {
            await ctx.{{plural (camelCase name)}}.add(
                {{pascalCase name}}.create({
                    id: {{constantCase name}}_ID,
                    clubId: CLUB_A_ID,
                    createdBy: EXHIBITOR_A_ID,
                    {{camelCase parent}}Id: {{constantCase parent}}_ID,
                    name: 'Exhibitor {{A (pascalCase name)}} {{pascalCase name}}',
                }),
            );
        });
    }, 120_000);

    afterAll(async () => {
        await harness.stop();
    });

    it('the creating exhibitor (matched by user_id) can find it', async () => {
        await unitOfWork.run(ExhibitorTransactionScope.of(EXHIBITOR_A_ID), async (ctx) => {
            const found = await ctx.{{plural (camelCase name)}}.findById({{constantCase name}}_ID);
            expect(found?.name).toBe('Exhibitor {{A (pascalCase name)}} {{pascalCase name}}');
        });
    });

    it('the owning Club (matched by club_id) can find it', async () => {
        await unitOfWork.run(ClubTransactionScope.of(CLUB_A_ID, CLUB_A_PRINCIPAL_ID), async (ctx) => {
            const found = await ctx.{{plural (camelCase name)}}.findById({{constantCase name}}_ID);
            expect(found?.name).toBe('Exhibitor {{A (pascalCase name)}} {{pascalCase name}}');
        });
    });

    it('a different exhibitor cannot find it', async () => {
        await unitOfWork.run(ExhibitorTransactionScope.of(EXHIBITOR_B_ID), async (ctx) => {
            const found = await ctx.{{plural (camelCase name)}}.findById({{constantCase name}}_ID);
            expect(found).toBeUndefined();
        });
    });

    it('a different Club cannot find it', async () => {
        await unitOfWork.run(ClubTransactionScope.of(CLUB_B_ID, CLUB_B_PRINCIPAL_ID), async (ctx) => {
            const found = await ctx.{{plural (camelCase name)}}.findById({{constantCase name}}_ID);
            expect(found).toBeUndefined();
        });
    });
});
