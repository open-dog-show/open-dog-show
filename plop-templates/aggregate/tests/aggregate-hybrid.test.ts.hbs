import { describe, it, expect } from 'vitest';
import { asClubId, asPrincipalId, ClubEventScope } from '../../../../../src/Shared/index.js';
import {
    {{pascalCase name}},
    Invalid{{pascalCase name}}NameError,
} from '../../../../../src/{{dashCase context}}/domain/model/{{dashCase name}}/{{dashCase name}}.js';
import {
    as{{pascalCase name}}Id,
    as{{pascalCase parent}}Id,
} from '../../../../../src/{{dashCase context}}/domain/shared/domain-ids.js';

const CLUB_ID = asClubId('00000000-0000-4000-8000-000000000001');
const PRINCIPAL_ID = asPrincipalId('00000000-0000-4000-8000-000000000011');
const {{constantCase name}}_ID = as{{pascalCase name}}Id('00000000-0000-4000-8000-000000000021');
const {{constantCase parent}}_ID = as{{pascalCase parent}}Id('00000000-0000-4000-8000-000000000031');

describe('{{pascalCase name}}', () => {
    it('create records {{pascalCase name}}Created scoped to the owning Club, regardless of the actor', () => {
        const {{camelCase name}} = {{pascalCase name}}.create({
            id: {{constantCase name}}_ID,
            clubId: CLUB_ID,
            createdBy: PRINCIPAL_ID,
            {{camelCase parent}}Id: {{constantCase parent}}_ID,
            name: 'Original name',
        });

        const [event] = {{camelCase name}}.pullEvents();
        expect(event?.type).toBe('{{eventContext context}}.{{pascalCase name}}Created');
        expect(event?.scope).toEqual(ClubEventScope.of(CLUB_ID));
        expect(event?.payload).toEqual({ name: 'Original name' });
        expect({{camelCase name}}.name).toBe('Original name');
        expect({{camelCase name}}.{{camelCase parent}}Id).toBe({{constantCase parent}}_ID);
    });

    it('create rejects a blank name', () => {
        expect(() =>
            {{pascalCase name}}.create({
                id: {{constantCase name}}_ID,
                clubId: CLUB_ID,
                createdBy: PRINCIPAL_ID,
                {{camelCase parent}}Id: {{constantCase parent}}_ID,
                name: '   ',
            }),
        ).toThrow(Invalid{{pascalCase name}}NameError);
    });

    it('rehydrate does not record an event', () => {
        const {{camelCase name}} = {{pascalCase name}}.rehydrate({
            id: {{constantCase name}}_ID,
            clubId: CLUB_ID,
            createdBy: PRINCIPAL_ID,
            {{camelCase parent}}Id: {{constantCase parent}}_ID,
            name: 'Restored name',
        });

        expect({{camelCase name}}.pullEvents()).toEqual([]);
        expect({{camelCase name}}.name).toBe('Restored name');
    });

    it('rename records {{pascalCase name}}Renamed scoped to the owning Club', () => {
        const {{camelCase name}} = {{pascalCase name}}.rehydrate({
            id: {{constantCase name}}_ID,
            clubId: CLUB_ID,
            createdBy: PRINCIPAL_ID,
            {{camelCase parent}}Id: {{constantCase parent}}_ID,
            name: 'Old name',
        });

        {{camelCase name}}.rename('New name');

        const [event] = {{camelCase name}}.pullEvents();
        expect(event?.type).toBe('{{eventContext context}}.{{pascalCase name}}Renamed');
        expect(event?.scope).toEqual(ClubEventScope.of(CLUB_ID));
        expect(event?.payload).toEqual({ name: 'New name' });
        expect({{camelCase name}}.name).toBe('New name');
    });

    it('rename rejects a blank name', () => {
        const {{camelCase name}} = {{pascalCase name}}.rehydrate({
            id: {{constantCase name}}_ID,
            clubId: CLUB_ID,
            createdBy: PRINCIPAL_ID,
            {{camelCase parent}}Id: {{constantCase parent}}_ID,
            name: 'Old name',
        });

        expect(() => {{camelCase name}}.rename('')).toThrow(Invalid{{pascalCase name}}NameError);
    });
});
