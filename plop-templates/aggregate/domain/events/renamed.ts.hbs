import {
    asEventType,
    type AggregateId,
    type DomainEventFact,
    type EventScope,
    type EventType,
} from '../../../../../Shared/index.js';

/**
 * The fully-qualified event-type string for {@link {{pascalCase name}}Renamed}
 * — the wire/DB form stored in the outbox `type` column and the registry key
 * the codec uses to rehydrate a stored row back into a
 * {@link {{pascalCase name}}Renamed} instance.
 */
export const {{constantCase name}}_RENAMED_TYPE: EventType = asEventType(
    '{{eventContext context}}.{{pascalCase name}}Renamed',
);

/** Event-type-specific structured data carried by {@link {{pascalCase name}}Renamed}. */
export interface {{pascalCase name}}RenamedPayload {
    readonly name: string;
}

/**
 * The fact that {{a (pascalCase name)}} {{pascalCase name}} was renamed.
 *
 * Modelled as a **class event** implementing {@link DomainEventFact}
 * (ADR-0027): the `type` field is fixed to
 * {@link {{constantCase name}}_RENAMED_TYPE}; the payload is the typed
 * {@link {{pascalCase name}}RenamedPayload}. Carries no `eventId` /
 * `occurredAt` — those are envelope fields the unit of work stamps on
 * afterwards. A private `#brand` field makes the class **nominal** so a bare
 * envelope literal is not assignable to `{{pascalCase name}}Renamed`.
 *
 * Storage rehydration goes through {@link {{pascalCase name}}Renamed.rehydrate},
 * which the context's rehydration registry wires into the outbox codec /
 * polling dispatcher.
 */
export class {{pascalCase name}}Renamed implements DomainEventFact {
    // Nominal brand: a bare envelope literal lacks this private field, so it is
    // not assignable to `{{pascalCase name}}Renamed` — closes the structural-literal leak.
    // eslint-disable-next-line no-unused-private-class-members -- intentional nominal brand; exists for compile-time type pinning, not runtime use.
    readonly #brand = true;

    readonly type = {{constantCase name}}_RENAMED_TYPE;
    readonly scope: EventScope;
    readonly aggregateId: AggregateId;
    readonly payload: {{pascalCase name}}RenamedPayload;

    private constructor(
        scope: EventScope,
        aggregateId: AggregateId,
        payload: {{pascalCase name}}RenamedPayload,
    ) {
        this.scope = scope;
        this.aggregateId = aggregateId;
        this.payload = payload;
    }

    /** Constructs a {@link {{pascalCase name}}Renamed} fact — called by `{{pascalCase name}}.rename`. */
    static create(
        aggregateId: AggregateId,
        scope: EventScope,
        payload: {{pascalCase name}}RenamedPayload,
    ): {{pascalCase name}}Renamed {
        return new {{pascalCase name}}Renamed(scope, aggregateId, payload);
    }

    /**
     * Rehydrates a {@link {{pascalCase name}}Renamed} fact from a stored row's
     * already-validated fields — the path the outbox codec / polling
     * dispatcher use via the context's rehydration registry.
     */
    static rehydrate(fact: {
        readonly scope: EventScope;
        readonly aggregateId: AggregateId;
        readonly payload: {{pascalCase name}}RenamedPayload;
    }): {{pascalCase name}}Renamed {
        return new {{pascalCase name}}Renamed(fact.scope, fact.aggregateId, fact.payload);
    }
}
