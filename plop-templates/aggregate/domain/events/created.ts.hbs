    static rehydrate(fact: {
        readonly scope: EventScope;
        readonly aggregateId: AggregateId;
        readonly payload: {{pascalCase name}}CreatedPayload;
    }): {{pascalCase name}}Created {
        return new {{pascalCase name}}Created(fact.scope, fact.aggregateId, fact.payload);
