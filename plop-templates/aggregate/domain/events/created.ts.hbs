    static create(
        aggregateId: AggregateId,
        scope: EventScope,
        payload: {{pascalCase name}}CreatedPayload,
    ): {{pascalCase name}}Created {
        return new {{pascalCase name}}Created(scope, aggregateId, payload);
    }

    /**
