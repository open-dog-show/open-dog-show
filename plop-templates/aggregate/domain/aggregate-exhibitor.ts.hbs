    static rehydrate(input: {
        readonly id: {{pascalCase name}}Id;
        readonly createdBy: PrincipalId;
        readonly name: string;
    }): {{pascalCase name}} {
        return new {{pascalCase name}}(input.id, input.createdBy, input.name);
