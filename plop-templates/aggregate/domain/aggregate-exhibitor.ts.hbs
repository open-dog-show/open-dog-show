        const {{camelCase name}} = new {{pascalCase name}}(input.id, input.createdBy, input.name);
        {{camelCase name}}.record(
            {{pascalCase name}}Created.create(
                asAggregateId({{camelCase name}}.id),
                ExhibitorEventScope.of({{camelCase name}}.createdBy),
                { name: {{camelCase name}}.name },
