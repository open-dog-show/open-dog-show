import {
    requireActor,
    type PrincipalId,
    type Result,
    type TransactionScope,
} from '../../../Shared/index.js';
import { as{{pascalCase name}}Id, as{{pascalCase parent}}Id } from '../../domain/shared/domain-ids.js';
import { {{pascalCase name}}, Invalid{{pascalCase name}}NameError } from '../../domain/model/{{dashCase name}}/{{dashCase name}}.js';
import { {{pascalCase parent}}NotFoundError } from '../../domain/model/{{dashCase parent}}/{{dashCase parent}}.js';
import type { {{pascalCase context}}UnitOfWork, {{pascalCase context}}UnitOfWorkContext } from '../ports/unit-of-work.js';

/**
 * Inputs to {@link Create{{pascalCase name}}Handler.execute} that are not
 * derivable from the transaction scope or looked up from the referenced
 * {{pascalCase parent}}. The acting principal comes from the
 * `TransactionScope` (via {@link requireActor}); the owning Club comes from
 * the {{pascalCase parent}} being referenced (looked up by
 * `{{camelCase parent}}Id`), not from the caller — {{a (pascalCase name)}} {{pascalCase name}} is a
 * hybrid aggregate and the acting scope need not itself be `club`
 * (ADR-0026): trusting a caller-supplied `clubId` would let a
 * {{pascalCase name}} be attributed to a Club that does not actually own the
 * {{pascalCase parent}}.
 */
export interface Create{{pascalCase name}}Command {
    /** Aggregate id of the {{pascalCase name}} to create. */
    readonly id: string;
    /** The {{pascalCase parent}} this {{pascalCase name}} references; its `clubId` becomes the owner. */
    readonly {{camelCase parent}}Id: string;
    readonly name: string;
}

/** Primitive view of the created {{pascalCase name}} (B4). */
export interface Create{{pascalCase name}}Response {
    readonly id: string;
    readonly name: string;
}

/**
 * Use case: create {{a (pascalCase name)}} {{pascalCase name}} — a hybrid aggregate referencing an
 * existing {{pascalCase parent}} — and record the
 * `{{eventContext context}}.{{pascalCase name}}Created` fact in the same
 * transaction (ADR-0014).
 *
 * The transaction boundary, repository construction, and outbox write are
 * all hidden behind the injected {@link {{pascalCase context}}UnitOfWork}
 * port. This use case never touches domain events (ADR-0027):
 * `{{pascalCase name}}.create` records the fact itself, and saving the
 * {{pascalCase name}} through `ctx.{{plural (camelCase name)}}.add` pulls and
 * stamps it.
 */
export class Create{{pascalCase name}}Handler {
    constructor(private readonly unitOfWork: {{pascalCase context}}UnitOfWork) {}

    /**
     * @throws {ScopeMismatchError} when `scope` has no acting principal (a
     *   `platform` scope) — see {@link requireActor}. A technical fault
     *   (E4/E6), not part of the `Result` channel, so it is rethrown rather
     *   than caught below.
     */
    async execute(
        command: Create{{pascalCase name}}Command,
        scope: TransactionScope,
    ): Promise<
        Result<Create{{pascalCase name}}Response, Invalid{{pascalCase name}}NameError | {{pascalCase parent}}NotFoundError>
    > {
        const createdBy = requireActor(scope);
        try {
            return await this.unitOfWork.run(scope, (ctx) =>
                this.createInTransaction(ctx, command, createdBy),
            );
        } catch (error) {
            if (error instanceof Invalid{{pascalCase name}}NameError || error instanceof {{pascalCase parent}}NotFoundError) {
                return { ok: false, error };
            }
            throw error;
        }
    }

    /**
     * Reads the referenced {{pascalCase parent}} inside the same transaction that writes the
     * new {{pascalCase name}}, so "a {{pascalCase name}}'s owner is its {{pascalCase parent}}'s Club" can be enforced
     * without trusting a caller-supplied `clubId` (see
     * {@link Create{{pascalCase name}}Command}). Only the {{pascalCase name}} aggregate is written —
     * the {{pascalCase parent}} read is unlocked, so a concurrent rename of the {{pascalCase parent}}'s owning
     * Club between this read and commit is possible in principle; that
     * staleness window is accepted rather than guarded against, since the
     * read gives no stronger guarantee regardless of scope.
     */
    private async createInTransaction(
        ctx: {{pascalCase context}}UnitOfWorkContext,
        command: Create{{pascalCase name}}Command,
        createdBy: PrincipalId,
    ): Promise<
        Result<Create{{pascalCase name}}Response, Invalid{{pascalCase name}}NameError | {{pascalCase parent}}NotFoundError>
    > {
        const {{camelCase parent}}Id = as{{pascalCase parent}}Id(command.{{camelCase parent}}Id);
        const {{camelCase parent}} = await ctx.{{plural (camelCase parent)}}.findById({{camelCase parent}}Id);
        if ({{camelCase parent}} === undefined) {
            throw new {{pascalCase parent}}NotFoundError({{camelCase parent}}Id);
        }

        const {{camelCase name}} = {{pascalCase name}}.create({
            id: as{{pascalCase name}}Id(command.id),
            clubId: {{camelCase parent}}.clubId,
            createdBy,
            {{camelCase parent}}Id,
            name: command.name,
        });
        await ctx.{{plural (camelCase name)}}.add({{camelCase name}});
        return { ok: true, value: { id: {{camelCase name}}.id, name: {{camelCase name}}.name } };
    }
}
