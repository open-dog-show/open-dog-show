import type { Result, TransactionScope } from '../../../Shared/index.js';
import { as{{pascalCase name}}Id } from '../../domain/shared/domain-ids.js';
import {
    {{pascalCase name}}NotFoundError,
    Invalid{{pascalCase name}}NameError,
} from '../../domain/model/{{dashCase name}}/{{dashCase name}}.js';
import type { {{pascalCase context}}UnitOfWork } from '../ports/unit-of-work.js';

/** Inputs to {@link Rename{{pascalCase name}}Handler.execute}. */
export interface Rename{{pascalCase name}}Command {
    /** Aggregate id of the {{pascalCase name}} to rename. */
    readonly id: string;
    readonly name: string;
}

/** Primitive view of the renamed {{pascalCase name}} (B4). */
export interface Rename{{pascalCase name}}Response {
    readonly id: string;
    readonly name: string;
}

/**
 * Use case: rename an existing {{pascalCase name}} and record the
 * `{{eventContext context}}.{{pascalCase name}}Renamed` fact in the same
 * transaction (ADR-0014).
 *
 * Ownership is not re-derived here — `findById` only returns a row the
 * caller's RLS-scoped connection can already see, so a successful lookup
 * already proves the caller may act on it; this is the one shared shape for
 * every ownership scope (ADR-0026).
 */
export class Rename{{pascalCase name}}Handler {
    constructor(private readonly unitOfWork: {{pascalCase context}}UnitOfWork) {}

    async execute(
        command: Rename{{pascalCase name}}Command,
        scope: TransactionScope,
    ): Promise<
        Result<Rename{{pascalCase name}}Response, {{pascalCase name}}NotFoundError | Invalid{{pascalCase name}}NameError>
    > {
        try {
            return await this.unitOfWork.run<
                Result<Rename{{pascalCase name}}Response, {{pascalCase name}}NotFoundError | Invalid{{pascalCase name}}NameError>
            >(scope, async (ctx) => {
                const id = as{{pascalCase name}}Id(command.id);
                const {{camelCase name}} = await ctx.{{plural (camelCase name)}}.findById(id);
                if ({{camelCase name}} === undefined) {
                    throw new {{pascalCase name}}NotFoundError(id);
                }
                {{camelCase name}}.rename(command.name);
                await ctx.{{plural (camelCase name)}}.update({{camelCase name}});
                return { ok: true, value: { id: {{camelCase name}}.id, name: {{camelCase name}}.name } };
            });
        } catch (error) {
            if (error instanceof {{pascalCase name}}NotFoundError || error instanceof Invalid{{pascalCase name}}NameError) {
                return { ok: false, error };
            }
            throw error;
        }
    }
}
