import type { {{pascalCase context}}UnitOfWork } from '../ports/unit-of-work.js';

/** Inputs to {@link Create{{pascalCase name}}Handler.execute} that are not derivable from the transaction scope. */
export interface Create{{pascalCase name}}Command {
    /** Aggregate id of the {{pascalCase name}} to create. */
    readonly id: string;
    readonly name: string;
}

/** Primitive view of the created {{pascalCase name}} (B4). */
export interface Create{{pascalCase name}}Response {
    readonly id: string;
    readonly name: string;
}

/**
 * Use case: create {{a (pascalCase name)}} {{pascalCase name}} — owned solely by the acting
 * exhibitor, with no Club at all — and record the
 * `{{eventContext context}}.{{pascalCase name}}Created` fact in the same
 * transaction (ADR-0014).
 */
export class Create{{pascalCase name}}Handler {
    constructor(private readonly unitOfWork: {{pascalCase context}}UnitOfWork) {}

    /**
     * @throws {ScopeMismatchError} when `scope` has no acting principal (a
     *   `platform` scope) — see {@link requireActor}.
     */
    async execute(
        command: Create{{pascalCase name}}Command,
        scope: TransactionScope,
    ): Promise<Create{{pascalCase name}}Response> {
        const createdBy = requireActor(scope);
        return this.unitOfWork.run(scope, async (ctx) => {
            const {{camelCase name}} = {{pascalCase name}}.create({
                id: as{{pascalCase name}}Id(command.id),
                createdBy,
                name: command.name,
            });
            await ctx.{{plural (camelCase name)}}.add({{camelCase name}});
            return { id: {{camelCase name}}.id, name: {{camelCase name}}.name };
        });
    }
}
